# SoulAI clean branch deployment settings
# Copy this file to .env, then replace every value marked CHANGE_ME.
# Keep the resulting .env private and use chmod 600 on Linux.

# Image tag. Use clean for the moving branch tag, or pin a commit tag.
IMAGE_TAG=clean
IMAGE_REPOSITORY=ghcr.io/xjackzenvey/sub2api

# Web server
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# PostgreSQL credentials used by both PostgreSQL and SoulAI
POSTGRES_USER=soulai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=soulai

# Redis password. Leave empty to run Redis without authentication on the private network.
REDIS_PASSWORD=

# First admin account. It is created only on the first startup.
ADMIN_EMAIL=admin@soulai.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Generate both values with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
TOTP_ENCRYPTION_KEY=CHANGE_ME_TOTP_ENCRYPTION_KEY

# Optional settings
UPDATE_PROXY_URL=
UPDATE_GITHUB_TOKEN=
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true
