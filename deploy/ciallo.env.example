# CialloAI branch deployment settings
# Copy this file to .env, then replace every value marked CHANGE_ME.
# Keep this file private and use chmod 600 .env on Linux.

# Image tag. Use ciallo for the moving branch tag, or pin a commit tag.
IMAGE_TAG=ciallo

# Web server
BIND_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_MODE=release
RUN_MODE=standard
TZ=Asia/Shanghai

# PostgreSQL credentials used by both PostgreSQL and CialloAI
POSTGRES_USER=cialloai
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=cialloai

# Redis password. Leave empty to run Redis on the private Compose network without authentication.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# First admin account. It is created only on the first startup.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Generate both values with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_JWT_SECRET
TOTP_ENCRYPTION_KEY=CHANGE_ME_TOTP_ENCRYPTION_KEY

# Optional settings
UPDATE_PROXY_URL=
UPDATE_GITHUB_TOKEN=
SECURITY_URL_ALLOWLIST_ENABLED=false
SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=true
SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=true